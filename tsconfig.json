{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/ui/button": ["./src/shared/ui/button/src/index.ts"],
      "@/shared/ui/utils": ["./src/shared/ui/utils/src/index.ts"],
      "@/shared/ui/card": ["./src/shared/ui/card/src/index.ts"],
      "@/shared/ui/spinner": ["./src/shared/ui/spinner/src/index.ts"],
      "@/shared/ui/sheet": ["./src/shared/ui/sheet/src/index.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
